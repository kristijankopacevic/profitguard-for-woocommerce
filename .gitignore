# Composer dependencies are installed by `composer install`, not committed.
# The distributable ZIP contains no vendor tree at all: the plugin has zero
# runtime dependencies, and everything in vendor/ here is dev tooling.
/vendor/
/composer.lock
/node_modules/
/build/
/dist/
*.zip
.phpunit.result.cache
.phpcs-cache

# The SVN-ready tree is generated from the ZIP by bin/build-release.sh. It is a
# byte-for-byte copy of trunk plus the graphics, so committing it would store
# every plugin file three times.
/release/

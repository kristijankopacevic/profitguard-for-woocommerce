<?xml version="1.0"?>
<ruleset name="ProfitGuard for WooCommerce">
	<description>WordPress Coding Standards for ProfitGuard.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<!--
		Generated build output. release/ holds two more copies of every plugin
		file (trunk and the tag), so without this every violation - and every
		clean file - is counted three times and the totals stop meaning
		anything.
	-->
	<exclude-pattern>/release/*</exclude-pattern>
	<exclude-pattern>/assets-wporg/*</exclude-pattern>
	<exclude-pattern>/assets-src/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<!--
		The full WordPress standard: coding style, escaping, sanitisation,
		database safety and i18n. Not WordPress-Core alone - the Security and
		Extra sniffs are the ones that actually catch bugs.
	-->
	<rule ref="WordPress">
		<!--
			WordPress-Docs requires a @package tag and full docblocks, which the
			codebase has. What it also wants is a file comment on every file
			echoing the class comment; that is enforced and satisfied.
		-->

		<!--
			Short array syntax is forbidden by WPCS and the codebase complies
			(array() throughout), so nothing is excluded here.
		-->
	</rule>

	<!--
		The pure core (includes/Core, includes/Analysis, includes/Import/Mapper)
		is deliberately WordPress-free so it can be unit tested without
		WordPress. WPCS's i18n sniff wants every user-facing string wrapped in
		__(), but those classes must not call WordPress functions at all - they
		return machine constants and the admin layer translates them. Excluding
		the sniff for those paths is the honest resolution; the alternative
		would be to break the property that makes them testable.
	-->
	<rule ref="WordPress.WP.I18n">
		<exclude-pattern>/includes/Core/*</exclude-pattern>
		<exclude-pattern>/includes/Analysis/*</exclude-pattern>
		<exclude-pattern>/includes/Import/Mapper.php</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Class files are PSR-4, not WordPress's class-foo.php convention, because
		the plugin autoloads by namespace. The file NAMES are therefore
		deliberately non-WordPress; everything inside them follows the standard.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
		<exclude-pattern>/includes/*</exclude-pattern>
	</rule>

	<!--
		Tests follow PHPUnit's conventions, not WordPress's documentation ones.
		A test method's name IS its documentation - `test_a_leading_zero_settles
		_the_thousands_ambiguity` says more than any docblock would - and
		requiring a @return void on each of 191 of them adds noise, not safety.
		The production code is held to the full standard.
	-->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Text domain must match the plugin slug everywhere. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="profitguard-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- Prefix every global symbol, so nothing can collide with another plugin. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="profitguard"/>
				<element value="ProfitGuard"/>
				<element value="PROFITGUARD"/>
			</property>
		</properties>
	</rule>

	<!--
		bin/ is developer tooling: WP-CLI scripts that build the demo store, run a
		scan synchronously and smoke-render the admin pages. NONE of it ships - see
		the allow-list in bin/build-zip.sh - and it runs only on a developer's own
		throwaway Docker WordPress. It is still linted, because a broken dev script
		wastes just as much time as a broken plugin; but a handful of sniffs are
		wrong for this file type specifically, and each exclusion below says why.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<!--
			`wp eval-file` includes the script at GLOBAL scope, so every ordinary
			local variable in it is, technically, a global. Prefixing 74 loop
			counters with `profitguard_` would satisfy the sniff and make the
			scripts materially harder to read, for no collision risk: the file is
			included once, by hand, in a CLI process that then exits.
		-->
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<!-- Same cause: global scope is an artefact of eval-file, not a design. -->
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<!--
			tests/bootstrap.php defines ABSPATH. It is meant to: every shipped
			file guards itself with `defined( 'ABSPATH' ) || exit;`, which is the
			canonical form the WordPress.org Plugin Check requires, and the pure
			core is unit tested WITHOUT WordPress. Defining the constant in the
			test bootstrap is what lets those two facts coexist. The alternative
			- a second, plugin-specific escape hatch in the guard itself - is a
			bypass shipped to users, and Plugin Check rejects it, correctly.
		-->
		<exclude-pattern>/tests/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.rand_mt_rand">
		<!--
			The seeder needs REPRODUCIBLE randomness, which is the one case where
			mt_rand is right and wp_rand is wrong. A fixed mt_srand seed makes the
			demo store byte-identical on every machine, so a documented figure or a
			screenshot caption stays true. Nothing here is security-sensitive.
		-->
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.rand_seeding_mt_srand">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents">
		<!--
			WP_Filesystem exists so that a PLUGIN can write through a user's FTP or
			SSH credentials. A CLI script writing a temporary CSV into the container
			it is already running inside has no such indirection to respect.
		-->
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<!-- Reads a local sample CSV off disk. wp_remote_get fetches over HTTP. -->
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_is_writable">
		<!-- Checks whether the mounted samples/ directory can be written to. -->
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.SlowDBQuery">
		<!--
			The seeder deletes its own previous demo rows by looking them up on the
			_profitguard_demo meta key. That IS a meta query and it is exactly the
			right one: it is what makes re-running the seeder safe. It runs once, on
			a developer machine, against sixty products.
		-->
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>

	<!--
		WPCS only knows WordPress core's capabilities, so WooCommerce's own read
		as typos. This is the capability the whole plugin gates on.
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- The minimum WordPress this plugin supports. -->
	<config name="minimum_wp_version" value="6.4"/>

	<!-- PHP compatibility across everything WordPress itself supports. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
